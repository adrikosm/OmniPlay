--swiftversion 6.0
--indent 4
--maxwidth 140
--exclude .build,**/.build,Engines,docs,Fixtures
--stripunusedargs closure-only
--wraparguments before-first
--wrapcollections before-first
--commas always
# Single-line computed properties and one-line function bodies are idiomatic here.
--disable wrapPropertyBodies,wrapFunctionBodies,wrapMultilineStatementBraces
