# Build tools OmniPlay needs from Homebrew. Xcode itself comes from Apple (version pinned in .xcode-version).
brew "xcodegen"     # project.yml -> OmniPlay.xcodeproj
brew "ninja"        # native engine builds (mkxp-z, EasyRPG, FFmpeg)
brew "meson"        # mkxp-z
brew "scons"        # Godot
brew "pkg-config"
brew "minisign"     # signs native artefact manifests
