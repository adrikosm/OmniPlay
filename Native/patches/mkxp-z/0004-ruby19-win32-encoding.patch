 # branch in Win32API#call. RGSS1/2 games typically don't exercise
 # UTF-16 paths anyway (they ran on Windows ANSI codepages).
 
+# The Ruby 1.9 build has no UTF-16/UTF-32 encodings. Windows-API scripts (Zeus Video Player) tag their UTF-16
+# buffers with force_encoding('UTF-16LE') and would stop the game with "unknown encoding name". An encoding this
+# Ruby lacks keeps the bytes, tagged binary, which is all those buffers are used for here.
+class String
+  alias_method :mkxp_force_encoding, :force_encoding unless method_defined?(:mkxp_force_encoding)
+  def force_encoding(encoding)
+    mkxp_force_encoding(encoding)
+  rescue ArgumentError => e
+    raise unless e.message.start_with?('unknown encoding name')
+    mkxp_force_encoding('ASCII-8BIT')
+  end
+end
