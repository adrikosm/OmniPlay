+/* ---- OmniPlay: typed state requests ---- */
+
+namespace {
+struct RubyRequest {
+    std::string json;
+    mkxp_RubyReplyCallback cb = nullptr;
+    void *ctx = nullptr;
+};
+std::mutex s_rubyRequestMutex;
+std::deque<RubyRequest> s_rubyRequests;
+std::atomic<mkxp_RubyRequestHandler> s_rubyRequestHandler{nullptr};
+}
+
+void mkxp_enqueueRubyRequest(const char *jsonUTF8, mkxp_RubyReplyCallback cb, void *ctx) {
+    {
+        std::lock_guard<std::mutex> lock(s_rubyRequestMutex);
+        s_rubyRequests.push_back({jsonUTF8 ? jsonUTF8 : "", cb, ctx});
+    }
+    /* Wake a paused engine (mkxp_checkPause) so it answers now. */
+    { std::lock_guard<std::mutex> lock(s_pauseMutex); }
+    s_pauseCV.notify_all();
+}
+
+bool mkxp_hasRubyRequests(void) {
+    std::lock_guard<std::mutex> lock(s_rubyRequestMutex);
+    return !s_rubyRequests.empty();
+}
+
+void mkxp_setRubyRequestHandler(mkxp_RubyRequestHandler handler) {
+    s_rubyRequestHandler.store(handler, std::memory_order_release);
+}
+
+void mkxp_drainRubyRequests(void) {
+    RubyRequest request;
+    {
+        std::lock_guard<std::mutex> lock(s_rubyRequestMutex);
+        if (s_rubyRequests.empty())
+            return;
+        request = std::move(s_rubyRequests.front());
+        s_rubyRequests.pop_front();
+    }
+    mkxp_RubyRequestHandler handler = s_rubyRequestHandler.load(std::memory_order_acquire);
+    if (handler)
+        handler(request.json.c_str(), request.cb, request.ctx);
+    else if (request.cb)
+        request.cb("{\"error\":\"no Ruby binding\"}", request.ctx);
+}
+
 #endif /* MKXPZ_MOBILE */
