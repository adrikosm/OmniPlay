+/* OmniPlay: typed state requests (app_bridge mkxp_enqueueRubyRequest), evaluated on the engine thread by the host's
+ * preload script. OmniPlay::Bridge.handle rescues its own errors and answers JSON; this only guards the call. */
+static VALUE omniplayRequestEval(VALUE) {
+    return rb_eval_string("defined?(OmniPlay::Bridge) ? OmniPlay::Bridge.handle($omniplay_request).to_s : "
+                          "'{\"error\":\"bridge not loaded\"}'");
+}
+
+static void omniplayHandleRequest(const char *json, mkxp_RubyReplyCallback cb, void *ctx) {
+    rb_gv_set("$omniplay_request", rb_str_new2(json));
+    int state = 0;
+    VALUE result = rb_protect(omniplayRequestEval, Qnil, &state);
+    rb_gv_set("$omniplay_request", Qnil);
+    if (state) {
+        rb_set_errinfo(Qnil);
+        if (cb) cb("{\"error\":\"the bridge raised\"}", ctx);
+        return;
+    }
+    if (cb) cb(RSTRING_PTR(result), ctx);
+}
+
 static void mriBindingInit() {
+    mkxp_setRubyRequestHandler(omniplayHandleRequest);
 #ifdef MKXPZ_HAVE_SYNTAX_TRANSFORM_PATCHES
 #if RAPI_MAJOR > 1 || (RAPI_MAJOR == 1 && RAPI_MINOR > 8)
     if (mkxp_legacy_stub_can_run(1, 8)) {
