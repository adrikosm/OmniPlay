+/*
+ * 7-Zip's key: SHA-256 over (salt, UTF-16LE passphrase, 64-bit little-endian
+ * counter), the counter running to 2^cycles. Properties: cycles in the low six
+ * bits of the first byte; its top bits and the second byte give the salt and IV
+ * sizes, which follow.
+ */
+static int
+aes_init(struct archive_read *a, struct _7zip *zip,
+    const struct _7z_coder *coder)
+{
+	const unsigned char *p = coder->properties;
+	unsigned char salt[16], iv[16] = {0};
+	unsigned salt_size = 0, iv_size = 0;
+	int cycles;
+	const char *passphrase;
+	CCCryptorRef ref;
+
+	aes_free(zip);
+	if (coder->propertiesSize < 1)
+		goto damaged;
+	cycles = p[0] & 0x3f;
+	if (p[0] & 0xc0) {
+		if (coder->propertiesSize < 2)
+			goto damaged;
+		salt_size = ((p[0] >> 7) & 1) + (p[1] >> 4);
+		iv_size = ((p[0] >> 6) & 1) + (p[1] & 0x0f);
+		if (coder->propertiesSize < 2 + salt_size + iv_size)
+			goto damaged;
+		memcpy(salt, p + 2, salt_size);
+		memcpy(iv, p + 2 + salt_size, iv_size);
+	}
+	/* 0x3f means a raw key, which 7-Zip never writes; real archives use 19. */
+	if (cycles > 24) {
+		archive_set_error(&a->archive, ARCHIVE_ERRNO_MISC,
+		    "Unsupported 7-Zip AES key derivation");
+		return (ARCHIVE_FAILED);
+	}
+	/* The first passphrase given; the key cache below assumes one. */
+	__archive_read_reset_passphrase(a);
+	passphrase = __archive_read_next_passphrase(a);
+	if (passphrase == NULL) {
+		archive_set_error(&a->archive, ARCHIVE_ERRNO_MISC,
+		    "Passphrase required for this entry");
+		return (ARCHIVE_FAILED);
+	}
+	if (zip->aes_key_cycles != cycles || zip->aes_key_salt_size != salt_size ||
+	    memcmp(zip->aes_key_salt, salt, salt_size) != 0) {
+		CC_SHA256_CTX ctx;
+		unsigned char counter[8];
+		uint64_t i, rounds = (uint64_t)1 << cycles;
+		size_t len;
+		unsigned char *password = aes_password_utf16le(passphrase, &len);
+
+		if (password == NULL)
+			goto nomem;
+		CC_SHA256_Init(&ctx);
+		for (i = 0; i < rounds; i++) {
+			archive_le64enc(counter, i);
+			CC_SHA256_Update(&ctx, salt, salt_size);
+			CC_SHA256_Update(&ctx, password, (CC_LONG)len);
+			CC_SHA256_Update(&ctx, counter, sizeof(counter));
+		}
+		CC_SHA256_Final(zip->aes_key, &ctx);
+		free(password);
+		memcpy(zip->aes_key_salt, salt, salt_size);
+		zip->aes_key_salt_size = salt_size;
+		zip->aes_key_cycles = cycles;
+	}
+	if (zip->aes_buff == NULL &&
+	    (zip->aes_buff = malloc(AES_BUFF_SIZE)) == NULL)
+		goto nomem;
+	if (CCCryptorCreate(kCCDecrypt, kCCAlgorithmAES, 0, zip->aes_key,
+	    kCCKeySizeAES256, iv, &ref) != kCCSuccess) {
+		archive_set_error(&a->archive, ARCHIVE_ERRNO_MISC,
+		    "Cannot start AES decryption");
+		return (ARCHIVE_FATAL);
+	}
+	zip->aes = ref;
+	return (ARCHIVE_OK);
+damaged:
+	archive_set_error(&a->archive, ARCHIVE_ERRNO_FILE_FORMAT,
+	    "Damaged 7-Zip AES properties");
+	return (ARCHIVE_FATAL);
+nomem:
+	archive_set_error(&a->archive, ENOMEM, "No memory for 7-Zip decryption");
+	return (ARCHIVE_FATAL);
+}
+
+/* Decrypts n bytes (whole AES blocks) of the packed stream into aes_buff. */
+static int
+aes_decrypt(struct archive_read *a, struct _7zip *zip, const void *in, size_t n)
+{
+	size_t moved = 0;
+
+	if (CCCryptorUpdate((CCCryptorRef)zip->aes, in, n, zip->aes_buff,
+	    AES_BUFF_SIZE, &moved) != kCCSuccess || moved != n) {
+		archive_set_error(&a->archive, ARCHIVE_ERRNO_MISC,
+		    "AES decryption failed");
+		return (ARCHIVE_FATAL);
+	}
+	zip->aes_offset = 0;
+	zip->aes_avail = n;
+	return (ARCHIVE_OK);
+}
