 static const int kQueuedInputEventDelay = 50;
 
+#ifdef OMNIPLAY_HOST
+// Called on the engine thread every time the engine polls, which is at least once a frame: counts frames for the
+// host's watchdog and delivers host requests that must not be pushed from the main thread (leave the game).
+bool omniplay_poll(Common::Event &event);
+#endif
+
 bool OSystem_iOS7::pollEvent(Common::Event &event) {
 	//printf("pollEvent()\n");
+#ifdef OMNIPLAY_HOST
+	if (omniplay_poll(event))
+		return true;
+#endif
 
 	long curTime = getMillis();
 
