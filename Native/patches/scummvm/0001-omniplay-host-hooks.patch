 	}
 }
 
+#ifdef OMNIPLAY_HOST
+// OmniPlay writes ScummVM's messages into the game session's log; stdout and stderr go nowhere on a phone.
+bool omniplay_log(const char *message);
+#endif
+
 void OSystem_iOS7::logMessage(LogMessageType::Type type, const char *message) {
 	FILE *output = 0;
+#ifdef OMNIPLAY_HOST
+	if (type == LogMessageType::kError)
+		_lastErrorMessage = message;
+	if (omniplay_log(message))
+		return;
+#endif
 
 	if (type == LogMessageType::kInfo || type == LogMessageType::kDebug)
 		output = stdout;
