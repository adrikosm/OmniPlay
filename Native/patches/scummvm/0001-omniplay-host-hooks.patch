@@ -143,7 +143,14 @@ Common::Array<uint> OSystem_iOS7::getSupportedAntiAliasingLevels() const {
 
 #if defined(USE_OPENGL) && defined(USE_GLAD)
 void *OSystem_iOS7::getOpenGLProcAddress(const char *name) const {
+#ifdef OMNIPLAY_HOST
+	// Other engines in the same process bring ANGLE, which exports the same gl* names; RTLD_DEFAULT could bind to
+	// those. ScummVM draws into an EAGL context, so its functions come from Apple's OpenGL ES.
+	static void *gles = dlopen("/System/Library/Frameworks/OpenGLES.framework/OpenGLES", RTLD_LAZY | RTLD_LOCAL);
+	return dlsym(gles, name);
+#else
 	return dlsym(RTLD_DEFAULT, name);
+#endif
 }
 #endif
 
