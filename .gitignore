# ---- Xcode / Swift ----
# OmniPlay.xcodeproj is generated by xcodegen from project.yml: regenerate, never commit.
*.xcodeproj/
*.xcworkspace/
xcuserdata/
DerivedData/
.build/
.swiftpm/
*.ipa
*.dSYM
*.dSYM.zip
*.xcarchive
*.xcresult
*.hmap
.DS_Store
.AppleDouble
._*

# ---- Signing and secrets ----
Signing.xcconfig
*.mobileprovision
*.provisionprofile
*.p12
*.cer
*.certSigningRequest
minisign.key
*.minisign.key
*.pem
*.key
.netrc
.env
.env.*

# ---- Native artefacts (reproducible from Scripts/native) ----
Native/**/prebuilt/
Native/**/build/
Native/**/install*/
Native/**/third_party/
*.a
*.o
*.d
*.dylib
*.xcframework/
*.framework/
*.jgp
!Fixtures/synthetic/*.jgp

# ---- Logs, temp, editors ----
__pycache__/
*.log
*.jsonl
Logs/
.idea/
.vscode/
*.swp
.swiftlint.cache/
