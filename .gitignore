# OmniPlay is a public repository that carries code only. Anything else stays on the developer's Mac.

# ---- Xcode / Swift ----
# OmniPlay.xcodeproj is generated by xcodegen from project.yml: regenerate, never commit.
*.xcodeproj/
*.xcworkspace/
xcuserdata/
DerivedData/
.build/
.swiftpm/
*.ipa
*.dSYM
*.dSYM.zip
*.xcarchive
*.xcresult
*.hmap
.DS_Store
.AppleDouble
._*

# ---- Signing and secrets ----
Signing.xcconfig
*.mobileprovision
*.provisionprofile
*.p12
*.cer
*.certSigningRequest
minisign.key
*.minisign.key
.env
.env.*
*.pem
*.key
.netrc
# Per-machine overrides of any committed config
*.local
*.local.*

# ---- Native artefacts (reproducible from Native/scripts) ----
Native/**/prebuilt/
Native/**/build/
Native/**/install*/
Native/**/third_party/
*.a
*.o
*.dylib
# Compiler dependency files embed absolute paths from this Mac
*.d
*.xcframework/
*.framework/

# ---- Fixtures: private and large ones never leave this machine ----
Fixtures/private/**
!Fixtures/private/.gitkeep
!Fixtures/private/README.txt
Fixtures/large/**
!Fixtures/large/.gitkeep
Corpus/
*.jgp
!Fixtures/synthetic/*.jgp

# ---- Documentation: README.md is the only markdown that ships ----
*.md
*.markdown
*.mdx
!README.md
docs/
*.pdf
*.docx

# ---- AI-assistant files ----
.claude/
CLAUDE.md
CLAUDE.local.md
AGENTS.md
GEMINI.md
.cursor/
.cursorrules
.cursorignore
.windsurf/
.windsurfrules
.continue/
.aider*
.codex/
.mcp.json
mcp.json
.skills/
*.skill
.github/copilot-instructions.md
.github/instructions/
.roo/
.clinerules
.gemini/
.copilot/
.claude.json
.agents/
.kiro/
.junie/
.augment/
.opencode/
opencode.json
.qwen/
.coderabbit.yaml
.coderabbit.yml
llms.txt
*.agent.md
memory/
scratchpad/
tmp/
# Throwaway XCUITest drivers used to steer the simulator by hand
Scratch*.swift

# ---- Logs, temp, editors ----
__pycache__/
*.log
*.jsonl
Logs/
.idea/
.vscode/
*.swp
.swiftlint.cache/
